class Solution {
    public int maxDepth(String s) {
        int depth=0;
        int maxdepth=0;
        char[] arr=s.toCharArray();
        for(char c:arr)
        {
            if(c=='(')
                depth++;
            else if(c==')')
            {
                maxdepth=Math.max(maxdepth,depth);
                depth--;
            }
            else
            {
                continue;
            }
        }

        return maxdepth;
    }

}
