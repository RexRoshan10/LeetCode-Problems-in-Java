class Solution {
    public int smallestIndex(int[] nums) {
        int sum=0;
        int num,val;
        for(int i=0;i<nums.length;i++)
        {
            num=nums[i];
            while(num>0)
            {
                val=num%10;
                num/=10;
                sum+=val;
            }
            if(sum==i)
                return i;

            sum=0;
        }
        return -1;
    }
}
