class Solution {
    public boolean hasValidPath(char[][] grid) {

        int m = grid.length;
        int n = grid[0].length;

        if ((m + n - 1) % 2 == 1)
            return false;

        if (grid[0][0] == ')' || grid[m - 1][n - 1] == '(')
            return false;

        boolean[][][] dp = new boolean[m][n][m + n];

        dp[0][0][1] = true;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                for (int open = 0; open < m + n; open++) {

                    if (!dp[i][j][open])
                        continue;

                    // Move down
                    if (i + 1 < m) {
                        int newOpen = open;

                        if (grid[i + 1][j] == '(')
                            newOpen++;
                        else
                            newOpen--;

                        if (newOpen >= 0)
                            dp[i + 1][j][newOpen] = true;
                    }

                    // Move right
                    if (j + 1 < n) {
                        int newOpen = open;

                        if (grid[i][j + 1] == '(')
                            newOpen++;
                        else
                            newOpen--;

                        if (newOpen >= 0)
                            dp[i][j + 1][newOpen] = true;
                    }
                }
            }
        }

        return dp[m - 1][n - 1][0];
    }
}
