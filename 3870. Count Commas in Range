class Solution {
    public int countCommas(int n) {
        
        int count=0;

        
        if(n<1000)
            return 0;
        else
            {
                for(int i=1000;i<=n;i++)
                {
                    int numbersize=String.valueOf(i).length();
                    int commacount=0;
                    if(numbersize%3==0)
                    {
                        commacount=(numbersize-1)/3;
                    }
                    else
                        commacount=numbersize/3;
                    
                    if(i*10<=n)
                    {
                        
                        count+=commacount*(i*10 - i)+1;
                        i=i*10;
                        continue;
                    }
                    else
                    {
                        count+=commacount*(n-i)+1;
                        break;
                    }
                    
                }
                return count;
                
            }

        }
}
