class Solution {
    public int[] longestRepeating(String s, String queryCharacters, int[] queryIndices) {
        int[] list= new int[queryIndices.length];
        char[] arr=s.toCharArray();
        for(int i=0;i<queryIndices.length;i++)
        {
            arr[queryIndices[i]]=queryCharacters.charAt(i);
            int longest=0;
            char prev=arr[0];
            int start=0;
            for(int j=1;j<arr.length; j++)
            {
                if(prev==arr[j])
                    continue;
                else
                {
                    prev=arr[j];
                    longest=Math.max(longest,j-start);
                    start=j;
                }

            }
            longest = Math.max(longest, arr.length - start);

            list[i]=longest;
        }
        return list;
    }
}
