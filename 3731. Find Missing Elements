class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        Arrays.sort(nums);

        List<Integer> answer = new ArrayList<>();

        int expected = nums[0];
        int index = 0;

        while (expected <= nums[nums.length - 1]) {

            if (index < nums.length && nums[index] == expected) {
                index++;
            } else {
                answer.add(expected);
            }

            expected++;
        }

        return answer;
    }
}
