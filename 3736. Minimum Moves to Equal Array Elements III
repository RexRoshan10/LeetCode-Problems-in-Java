class Solution {
    public int minMoves(int[] nums) {
        if(nums.length==1)
            return 0;
        Arrays.sort(nums);
        int max=nums[nums.length-1];
        long result=0;
        for(int i:nums)
        {
            result+=Math.abs(max-i);
        }

        return (int) result;
    }
}
